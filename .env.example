# Copy this file to `.env` in the project root and fill in real values.
# Get them from the team password manager. NEVER commit `.env`.

# Shopify Storefront API (read-only storefront token — articles + product metafields)
SHOPIFY_DOMAIN=organicsbestshop.com
SHOPIFY_STOREFRONT_TOKEN=

# Pinecone — YOUR PERSONAL key (created per person in the console, never shared).
# Also stored in ~/.claude/settings.json by /setup-keys.
PINECONE_API_KEY=
PINECONE_INDEX=blog-archive

# Elicit (optional — paper research; PubMed fallback works without it)
ELICIT_API_KEY=
